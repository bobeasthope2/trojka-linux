diff -ruN empty/tests/ttytest.py docs2/tests/ttytest.py
--- a/tests/ttytest.py	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/ttytest.py	2026-11-04 13:47:44.087794226 +0000
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Drive trojka inside a pseudo-terminal and dump rendered screens.
+
+Usage:  ttytest.py <steps-file> [-- cmd ...]
+
+Each line of the steps file is:   <delay-seconds> <TAB> <keys> <TAB> <label>
+`keys` is a python string literal (so "\\n", "\\x0c" etc. work); empty means
+"just wait".  After each step the emulated 80x25 screen is printed.
+"""
+import os, pty, select, signal, sys, time
+
+import pyte
+
+COLS = int(os.environ.get("TTYTEST_COLS", 80))
+ROWS = int(os.environ.get("TTYTEST_ROWS", 25))
+
+
+def render(screen, label, step):
+    print("=" * 78)
+    print(f"[step {step}] {label}")
+    print("=" * 78)
+    for y, line in enumerate(screen.display, 1):
+        print(f"{y:2d}|{line.rstrip()}")
+    print()
+
+
+def main():
+    steps_file = sys.argv[1]
+    cmd = sys.argv[sys.argv.index("--") + 1:] if "--" in sys.argv else ["./trojka"]
+
+    steps = []
+    with open(steps_file) as fh:
+        for raw in fh:
+            raw = raw.rstrip("\n")
+            if not raw or raw.startswith("#"):
+                continue
+            delay, keys, label = raw.split("\t")
+            steps.append((float(delay), eval('"' + keys + '"'), label))
+
+    stream = pyte.Stream(pyte.Screen(COLS, ROWS))
+    screen = stream.listener
+
+    pid, fd = pty.fork()
+    if pid == 0:
+        # vt100 has no `rep` capability; pyte does not implement ECMA-48 REP
+        os.environ["TERM"] = os.environ.get("TTYTEST_TERM", "vt100")
+        os.environ["LINES"] = str(ROWS)
+        os.environ["COLUMNS"] = str(COLS)
+        os.execvp(cmd[0], cmd)
+
+    import fcntl, struct, termios
+    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", ROWS, COLS, 0, 0))
+
+    def pump(seconds):
+        end = time.time() + seconds
+        while True:
+            left = end - time.time()
+            if left <= 0:
+                return True
+            r, _, _ = select.select([fd], [], [], left)
+            if not r:
+                continue
+            try:
+                data = os.read(fd, 65536)
+            except OSError:
+                return False
+            if not data:
+                return False
+            stream.feed(data.decode("utf-8", "replace"))
+
+    alive = pump(0.6)
+    for n, (delay, keys, label) in enumerate(steps, 1):
+        if not alive:
+            print(f"!! child exited before step {n} ({label})")
+            break
+        if keys:
+            os.write(fd, keys.encode())
+        alive = pump(delay)
+        render(screen, label, n)
+
+    # drain and reap
+    pump(0.5)
+    try:
+        os.close(fd)
+    except OSError:
+        pass
+    try:
+        _, status = os.waitpid(pid, os.WNOHANG)
+    except ChildProcessError:
+        status = 0
+    else:
+        if _ == 0:
+            os.kill(pid, signal.SIGKILL)
+            _, status = os.waitpid(pid, 0)
+    if os.WIFSIGNALED(status):
+        print(f"### child killed by signal {os.WTERMSIG(status)}")
+        sys.exit(1)
+    print(f"### child exit status {os.WEXITSTATUS(status)}")
+
+
+main()
