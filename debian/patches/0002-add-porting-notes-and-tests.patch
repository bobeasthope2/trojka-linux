diff -ruN empty/tests/seqrand.c docs2/tests/seqrand.c
--- a/tests/seqrand.c	1970-01-01 01:00:00.000000000 +0100
+++ b/tests/seqrand.c	2026-11-04 13:50:16.688876899 +0000
@@ -0,0 +1,15 @@
+/* rand() returns a scripted sequence from $RANDSEQ (comma separated), looping */
+#include <stdlib.h>
+#include <string.h>
+static int seq[64], n, idx;
+static void load(void) {
+    const char *s = getenv("RANDSEQ");
+    char buf[256], *p, *save;
+    if (!s) { seq[0]=0; n=1; return; }
+    strncpy(buf, s, sizeof buf - 1); buf[sizeof buf - 1]=0;
+    for (p = strtok_r(buf, ",", &save); p && n < 64; p = strtok_r(NULL, ",", &save))
+        seq[n++] = atoi(p);
+    if (!n) { seq[0]=0; n=1; }
+}
+int rand(void) { if (!n) load(); return seq[idx++ % n]; }
+void srand(unsigned s) { (void)s; }
